# Supabase Persistent Storage (Vercel & Browser)
# Browser-safe client credentials for Supabase persistent world & messages
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Server-only privileged Supabase access for Vercel Serverless / background tasks
